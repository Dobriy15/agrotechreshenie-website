{$DOMAIN} {
	encode zstd gzip
	request_body max_size 60MB

	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=2592000"
		file_server
	}
	handle {
		reverse_proxy web:8000
	}
}

# Если у домена есть www — раскомментируйте, чтобы редиректить на основной адрес
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
